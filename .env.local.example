# Copia este archivo a .env.local y rellena los valores.
# Supabase → Project Settings → API (o "Connect" en la cabecera del proyecto).

# URL del proyecto, p. ej. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública: la "anon" (JWT) o la nueva "publishable" (sb_publishable_...). Ambas valen.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional: avisos en un canal de Microsoft Teams al publicar la canción del día.
# Teams → canal → ⋯ → Workflows → "Publicar en un canal cuando se reciba una solicitud de webhook".
# Solo en el servidor (sin NEXT_PUBLIC_): no se expone al navegador.
TEAMS_WEBHOOK_URL=
